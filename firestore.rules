rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Media Assets Master Catalog
    // Both Admin and Client panels connect to this same collection in real time.
    // Clients can browse, inspect, and request bookings, but are strictly forbidden from deleting assets.
    match /mediaAssets/{assetId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth == null || (
        request.auth.token.email == 'admin@blaze.com.pk' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Client Campaign Bookings & Reservations
    // Real-time synchronization between Admin Booking Desk and Client My Bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if isValidId(bookingId);
    }

    // Media Vendors & Concessionaires Master Directory
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isValidId(vendorId);
    }

    // System Admins
    match /admins/{adminUid} {
      allow read, write: if true;
    }

    // Registered Client User Profiles & Accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Connection Health Check collection (used by testConnection)
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
